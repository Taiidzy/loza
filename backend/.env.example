# Copy to .env and fill in your values

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=authdb

# App
JWT_SECRET=change_this_to_a_long_random_secret_in_production
PORT=4242
# Папка для данных хранилища (photos/video/docs/backups/other). По умолчанию — ./storage
# STORAGE_ROOT=./storage

# Logging: error | warn | info | debug | trace
RUST_LOG=auth_backend=debug,tower_http=info
