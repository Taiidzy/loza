# Порт, на котором будет работать backend.
PORT=4242

# IP-адрес, к которому привязывается backend.
# 127.0.0.1 — если используется Nginx/Apache/Caddy как reverse proxy.
# 0.0.0.0 — если backend должен быть доступен напрямую по сети.
BACKEND_BIND_ADDRESS=0.0.0.0

# Доверять ли заголовкам X-Forwarded-* от reverse proxy.
# Включайте (true) только если backend доступен ТОЛЬКО через доверенный proxy.
# Если backend открыт напрямую в интернет или локальную сеть — оставьте false.
TRUST_PROXY_HEADERS=false

# Настройки подключения к PostgreSQL.
POSTGRES_PORT=5432
POSTGRES_DB=loza
POSTGRES_USER=loza
POSTGRES_PASSWORD=change_me_to_a_long_random_password

# Секретный ключ для подписи JWT-токенов.
# Используйте случайную строку длиной не менее 64 символов.
JWT_SECRET=change_me_to_a_64_char_random_secret

# Учётная запись администратора, создаваемая при первом запуске.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change_me_to_a_long_unique_admin_password
BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator

# Уровень логирования.
# info — обычная работа.
# debug — подробные логи для отладки.
# warn/error — только предупреждения и ошибки.
RUST_LOG=loza_server=info,tower_http=info

# Путь к каталогу, в котором будут храниться все пользовательские файлы.
# Можно указать как относительный, так и абсолютный путь.
STORAGE_ROOT=./storage